{
 "contract": "plugin/1",
 "part": "service",
 "name": "service_write_in_a_commit",
 "caller": "svc_consumer",
 "service": "svc_provider.record",
 "on": "commit",
 "input": {
  "voucher": "v1",
  "amount": {
   "value": "7.25",
   "currency": "USD"
  }
 },
 "expect": {
  "output": {
   "voucher": "v1",
   "ledger_lines": [
    {
     "account": "@acct:1100",
     "debit": {
      "value": "7.25",
      "currency": "USD"
     },
     "credit": {
      "value": "0.00",
      "currency": "USD"
     }
    },
    {
     "account": "@acct:4100",
     "debit": {
      "value": "0.00",
      "currency": "USD"
     },
     "credit": {
      "value": "7.25",
      "currency": "USD"
     }
    }
   ]
  }
 },
 "note": "A write service runs on an approved commit's context; account ids are symbols, @acct:<number>."
}
